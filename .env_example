# =============================================================================
# SOMENTE LOCAL / DEMO — NÃO reutilize estes valores em ambiente compartilhado
# ou deploy. Antes de qualquer uso além da sua máquina, gere novos:
#   ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   PEPPER_SECRET / ADMIN_API_TOKEN: strings longas únicas (≥32 chars em production)
# `pnpm docker:up` força NODE_ENV=production no container api — o schema rejeita
# placeholders fracos (changeme, EXAMPLE_*, postgrespassword).
# =============================================================================

PORT=3000
NODE_ENV=development

# PostgreSQL (Docker Compose mapeia host 5433 -> container 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=brain_ag_local_pg_2026
POSTGRES_DB=brain_agriculture
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://postgres:brain_ag_local_pg_2026@localhost:5433/brain_agriculture

# Field-Level Encryption (32 bytes em hex = 64 chars)
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em production (incl. Docker Compose) a chave hex de exemplo 0123…abcdef é rejeitada.
ENCRYPTION_KEY=3ab2f0c496445996b741f3b2a81218a0660e778045b32a4df4d76d0218a06faf
ENCRYPTION_KEY_ID=v1
# Rotação (opcional): chave anterior permanece válida para decrypt
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_ID=v0

# Blind index pepper (HMAC-SHA256) — em production exige ≥32 chars e ≠ change-me-pepper-secret-min-16
PEPPER_SECRET=jSTuYE-mCa66GNx04aDRVZtdWGuKv2xF-local-docker

# BrasilAPI
BRASIL_API_BASE_URL=https://brasilapi.com.br/api

# Revalidação PENDING (job assíncrono). 0/false = desliga.
REVALIDATE_PENDING_ENABLED=1
# 0 desliga parecer ESG e validação CAR (tela e API). 1 ou true liga.
ESG_CAR_ENABLED=0
REVALIDATE_PENDING_INTERVAL_MS=300000
REVALIDATE_PENDING_BATCH_SIZE=50

# Token admin para POST /api/v1/admin/revalidate/* (header X-Admin-Token)
# Sem token configurado, os endpoints retornam 401.
ADMIN_API_TOKEN=local-admin-token-min-8

# Produção: lista CSV de origens CORS (vazio = same-origin / sem CORS aberto)
CORS_ORIGINS=

# Rate limit (padrão: 100 req / 60s por IP). Skip: /health* e /metrics.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Atrás de reverse proxy (ALB/nginx): true para usar X-Forwarded-For no rate limit
TRUST_PROXY=false

# Limite do body JSON (express.json)
BODY_LIMIT=100kb

# OpenTelemetry (opcional): se definido, exporta traces via OTLP/HTTP
# Ex.: http://localhost:4318/v1/traces  ou  http://localhost:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=brain-ag-api

API_HOST_PORT=3000

# --- Client (Vite) — opcional em client/.env.local ---
# Default = API real via proxy /api → Nest. NÃO definir em produção/CI.
# VITE_USE_MOCKS=true
