PORT=3000
NODE_ENV=development

# PostgreSQL (Docker Compose mapeia host 5433 -> container 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=brain_agriculture
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/brain_agriculture

# Field-Level Encryption (32 bytes em hex = 64 chars)
# Gere para produção: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em NODE_ENV=production estes valores de exemplo são rejeitados.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Blind index pepper (HMAC-SHA256) — gere um segredo único em produção
PEPPER_SECRET=change-me-pepper-secret-min-16

# BrasilAPI
BRASIL_API_BASE_URL=https://brasilapi.com.br/api

# Produção: lista CSV de origens CORS (vazio = same-origin / sem CORS aberto)
CORS_ORIGINS=

# Rate limit (padrão: 100 req / 60s por IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

API_HOST_PORT=3000
