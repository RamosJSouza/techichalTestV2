PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=brain_agriculture
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/brain_agriculture

# Field-Level Encryption (32 bytes em hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Blind index pepper (HMAC-SHA256)
PEPPER_SECRET=change-me-pepper-secret-min-16

# BrasilAPI
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
