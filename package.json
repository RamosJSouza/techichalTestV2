{
  "name": "brain-ag-backend",
  "version": "0.0.1",
  "description": "Backend for Brain Agriculture",
  "author": "Ramos de Souza Janones",
  "email": "ramosinfo@gmail.com",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.22.3",
    "pnpm": "10.32.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm start:dev\" \"pnpm --filter @brain-ag/client dev\"",
    "dev:api": "pnpm start:dev",
    "dev:client": "pnpm --filter @brain-ag/client dev",
    "build": "concurrently -n web,api -c green,blue \"pnpm --filter @brain-ag/client build\" \"pnpm build:api\"",
    "build:api": "nest build",
    "build:client": "pnpm --filter @brain-ag/client build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"client/src/**/*.{ts,tsx}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ client/src/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js && pnpm --filter @brain-ag/client test",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:client": "pnpm --filter @brain-ag/client test",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "audit:ci": "pnpm audit --audit-level=high",
    "verify": "pnpm lint && pnpm test && pnpm test:e2e && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "bench:seed": "node --env-file=.env scripts/bench/seed-scale.mjs",
    "bench:verify": "node --env-file=.env scripts/bench/verify-aggregates.mjs",
    "bench:explain": "node --env-file=.env scripts/bench/explain-capture.mjs",
    "bench:load": "node --env-file=.env scripts/bench/load-http.mjs",
    "bench:bundle": "node scripts/bench/bundle-size.mjs",
    "bench:list-compare": "node --env-file=.env scripts/bench/list-producers-compare.mjs",
    "bench:run": "node --env-file=.env scripts/bench/run.mjs"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "axios": "^1.20.0",
    "drizzle-orm": "^0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "opossum": "^10.0.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.2"
  }
}
